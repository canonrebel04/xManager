<?xml version="1.0" encoding="utf-8"?>
<!--
    Debug builds only: same HTTPS-only rules as release, plus cleartext to the loopback
    address so instrumented tests can talk to a local MockWebServer. Release builds use
    src/main/res/xml/network_security_config.xml unchanged.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
